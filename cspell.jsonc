// Spell check (`npm run lint:spell`): American English in docs, comments,
// identifiers and the site's English copy (requirements §5, §13.6). Catalan and
// Spanish only where the site's copy is quoted on purpose. Also read by the VS
// Code Code Spell Checker.
{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "import": [
    "@cspell/dict-es-es/cspell-ext.json",
    "@cspell/dict-ca/cspell-ext.json",
  ],
  "useGitignore": true,
  "enableGlobDot": true,
  "files": ["**/*.{md,ts,js,mjs,astro,css,yml,yaml}"],
  "ignorePaths": [".git/", "package-lock.json", ".remember/", "public/"],
  "overrides": [
    {
      // Requirements, backlog, design prompts, pages, mock data and tests quote the copy in all three locales.
      // Components and styles hold no copy (it comes from the dictionaries), so their comments stay in English.
      "filename": [
        "docs/requirements.md",
        "docs/design/**",
        "TASKS.md",
        "src/pages/**",
        "src/data/**",
        "src/testing/**",
        "e2e/**",
      ],
      "language": "en-US,es,ca",
      // cspell splits words at the Catalan middle dot (excel·lència), so those words go unchecked.
      "ignoreRegExpList": ["/\\p{L}+·\\p{L}+/gu"],
      // Catalan words that flagWords rejects as British. The other flagged forms stay rejected here, for the English prose.
      "ignoreWords": ["centre", "metre", "metres"],
    },
  ],
  "languageSettings": [
    {
      // HTML and ARIA attribute names (aria-labelledby, fetchpriority) in the test assertions.
      "languageId": "typescript,javascript",
      "dictionaries": ["html"],
    },
    {
      // The Spanish dictionary turns case sensitivity on, which rejects lowercase names in URLs and paths.
      // With it off, cspell ignores accents too: a missing accent in Catalan or Spanish copy passes.
      "languageId": "*",
      "locale": "es",
      "caseSensitive": false,
    },
  ],
  // British forms the en-US dictionary accepts as variants. Not exhaustive: add one when it slips through.
  "flagWords": [
    "ageing->aging",
    "analogue->analog",
    "armour->armor",
    "artefact->artifact",
    "benefitted->benefited",
    "cancelled->canceled",
    "cancelling->canceling",
    "catalogue->catalog",
    "catalogued->cataloged",
    "centre->center",
    "centred->centered",
    "channelling->channeling",
    "coloured->colored",
    "cosy->cozy",
    "counselling->counseling",
    "dialled->dialed",
    "endeavour->endeavor",
    "enquiry->inquiry",
    "enrol->enroll",
    "enrolment->enrollment",
    "favour->favor",
    "favoured->favored",
    "fibre->fiber",
    "flavour->flavor",
    "focussed->focused",
    "focussing->focusing",
    "fuelled->fueled",
    "fulfil->fulfill",
    "grey->gray",
    "greyed->grayed",
    "greyish->grayish",
    "greys->grays",
    "harbour->harbor",
    "honour->honor",
    "honoured->honored",
    "humour->humor",
    "instalment->installment",
    "judgement->judgment",
    "judgemental->judgmental",
    "labelled->labeled",
    "labelling->labeling",
    "labour->labor",
    "learnt->learned",
    "levelled->leveled",
    "metre->meter",
    "metres->meters",
    "misspelt->misspelled",
    "modelled->modeled",
    "modelling->modeling",
    "mould->mold",
    "odour->odor",
    "orientated->oriented",
    "programme->program",
    "programmes->programs",
    "rigour->rigor",
    "rumour->rumor",
    "sceptic->skeptic",
    "signalling->signaling",
    "skilful->skillful",
    "spelt->spelled",
    "spoilt->spoiled",
    "theatre->theater",
    "totalling->totaling",
    "tunnelling->tunneling",
    "vigour->vigor",
    "whilst->while",
    "wilful->willful",
  ],
  // GitHub Actions' status function, not prose.
  "ignoreRegExpList": ["/!cancelled\\(\\)/g"],
  // File names (.htmlvalidate.json, .nvmrc), not words.
  "ignoreWords": ["htmlvalidate", "nvmrc"],
  "words": [
    "AEPD",
    "brittanychiang",
    "cookieless",
    "crossfade",
    "crossfades",
    "FOUC",
    "frontmatter",
    "Gantt",
    "Glassmorphism",
    "Grotesk",
    "gstatic",
    "HSTS",
    "lhci",
    "linkinator",
    "LOPDGDD",
    "Matheu",
    "negotiables",
    "nums",
    "oklab",
    "oklch",
    "oneline",
    "opsz",
    "overclaim",
    "Plastikaweb",
    "Polylang",
    "prerenders",
    "psudokit",
    "ramx",
    "rects",
    "rockstar",
    "showreel",
    "stylesheet",
    "theming",
    "typosquat",
    "uicolors",
    "unpushed",
    "unvetted",
    "viewports",
    "WCAG",
    "wght",
    "wpcli",
    "WPML",
  ],
}
