---
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const langs = ["en", "es", "ca"];
  const pages = ["blog", "skills", "contact", "legal"];

  return langs.flatMap((lang) =>
    pages.map((page) => ({
      params: { lang, uri: page },
      props: { title: page.charAt(0).toUpperCase() + page.slice(1) },
    })),
  );
}

const { lang, uri } = Astro.params;
const { title } = Astro.props;

const translations = [
  { uri: `/en/${uri}`, langCode: "EN", langName: "English" },
  { uri: `/es/${uri}`, langCode: "ES", langName: "Español" },
  { uri: `/ca/${uri}`, langCode: "CA", langName: "Català" },
];
---

<BaseLayout
  title={`${title} | ${lang!.toUpperCase()}`}
  description={`Technical details for ${title}`}
  lang={lang as string}
  translations={translations}
>
  <div class="content-reveal">
    <header class="page-header">
      <h1 class="text-gradient">{title}</h1>
      <p class="breadcrumbs">
        <a href={`/${lang}/`}>Home</a> / {uri}
      </p>
    </header>

    <div class="placeholder-card">
      <p>
        Building the <strong>{uri}</strong> experience for the 2026 relaunch...
      </p>
      <div class="meta-tag">{lang!.toUpperCase()} Version</div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-block-end: var(--space-fluid-l);
    border-block-end: 1px solid var(--glass-border);
    padding-block-end: var(--space-fluid-s);
  }

  .breadcrumbs {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-block-start: 1rem;
  }

  .breadcrumbs a {
    color: var(--color-text-link);
    text-decoration: none;
  }

  .placeholder-card {
    padding: var(--space-fluid-l);
    background: var(--color-surface);
    border: 1px solid var(--glass-border);
    border-radius: 0;
    text-align: center;
    margin-block-start: 2rem;
    box-shadow: var(--shadow-lg);
  }

  .meta-tag {
    display: inline-block;
    margin-block-start: 1.5rem;
    color: var(--color-text-link);
    font-weight: bold;
    background: var(--color-primary-subtle);
    padding: 0.25rem 0.75rem;
    border-radius: 0;
    font-size: 0.8rem;
  }

  .content-reveal {
    animation: reveal 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
