---
import "../styles/theme.css";

import { Font } from "astro:assets";

import ThemeToggle from "../components/ui/ThemeToggle.astro";

interface Translation {
  uri: string;
  langCode: string;
  langName: string;
}

interface Props {
  title: string;
  description: string;
  lang: string;
  translations?: Translation[];
  ogImage?: string;
  /** Preload Space Grotesk: only on pages that set it (home, case studies, 404). */
  preloadDisplayFont?: boolean;
}

const {
  title,
  description,
  lang,
  translations = [],
  ogImage,
  preloadDisplayFont = false,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Carlos Matheu</title>
    <meta name="description" content={description} />

    <script is:inline>
      const getTheme = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      };
      const theme = getTheme();
      document.documentElement.setAttribute("data-theme", theme);
    </script>
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage || "/default-og.png"} />

    {/* Fonts from the site's own domain (astro.config.mjs, requirements §4.2).
         Every family is declared on every page; browsers only fetch the ones in use. */}
    <Font cssVariable="--font-bricolage" />
    <Font cssVariable="--font-commit-mono" />
    <Font
      cssVariable="--font-space-grotesk"
      preload={
        preloadDisplayFont
          ? [{ weight: 700, style: "normal", subset: "latin" }]
          : false
      }
    />
  </head>
  <body>
    <!-- A11y: Skip Link -->
    <a href="#main-content" class="skip-link">
      Skip to content
    </a>

    <header class="glass-nav">
      <nav aria-label="Main Navigation">
        <div class="header-container">
          <div class="logo">
            <a href={`/${lang}/`}>PM.</a>
          </div>
          <div class="actions">
            <ul class="lang-list">
              {translations.map((t) => (
                <li>
                  <a
                    href={t.uri}
                    hreflang={t.langCode.toLowerCase()}
                    class:list={[
                      "lang-link",
                      {
                        active: t.langCode.toLowerCase() === lang.toLowerCase(),
                      },
                    ]}
                    aria-current={
                      t.langCode.toLowerCase() === lang.toLowerCase()
                        ? "page"
                        : undefined
                    }
                  >
                    <span class="lang-name">{t.langName}</span>
                    <span class="lang-code-short">{t.langCode}</span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="divider-v" aria-hidden="true"></div>
            <ThemeToggle />
          </div>
        </div>
      </nav>
    </header>

    <main id="main-content" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer>
      <div class="container footer-content">
        <p>
          © {new Date().getFullYear()} Carlos Matheu. Built with Astro &amp;
          WPGraphQL.
        </p>
      </div>
    </footer>

    <style>
      .skip-link {
        position: absolute;
        inset-block-start: -6.25rem;
        inset-inline-start: 0;
        background: var(--color-secondary);
        color: var(--color-text-on-secondary);
        padding: 1rem;
        z-index: 999;
      }

      .skip-link:focus {
        inset-block-start: 0;
      }

      .glass-nav {
        position: sticky;
        inset-block-start: 0;
        background: var(--glass-bg);
        backdrop-filter: blur(var(--glass-blur));
        border-block-end: 1px solid var(--glass-border);
        z-index: 100;
        padding: 1rem 0;
      }

      .header-container {
        max-width: var(--max-width-content);
        margin: 0 auto;
        padding: 0 var(--space-fluid-s);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .actions {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      .divider-v {
        width: 0.0625rem;
        height: 1.25rem;
        background: var(--glass-border);
      }

      .logo a {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--color-primary);
        text-decoration: none;
      }

      .container {
        max-width: var(--max-width-content);
        margin: 0 auto;
        padding: var(--space-fluid-l) var(--space-fluid-s);
      }

      .lang-list {
        display: flex;
        gap: 1.5rem;
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .lang-link {
        text-decoration: none;
        color: var(--color-text-secondary);
        font-weight: 500;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        transition: var(--transition-smooth);
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
      }

      .lang-link::after {
        content: "";
        position: absolute;
        inset-block-end: -0.25rem;
        width: 0;
        height: 0.125rem;
        background: var(--color-primary);
        transition: var(--transition-smooth);
      }

      .lang-link:hover,
      .lang-link.active {
        color: var(--color-text-primary);
      }

      .lang-link.active::after,
      .lang-link:hover::after {
        width: 100%;
      }

      .lang-link.active {
        color: var(--color-text-link);
        text-shadow: 0 0 0.625rem var(--color-primary-subtle);
      }

      .lang-name {
        display: none;
      }

      @media (width >= 48rem) {
        .lang-name {
          display: inline;
        }

        .lang-code-short {
          display: none;
        }
      }

      .footer-content {
        border-block-start: 1px solid var(--glass-border);
        text-align: center;
        color: var(--color-text-secondary);
        font-size: 0.9rem;
      }
    </style>
  </body>
</html>
