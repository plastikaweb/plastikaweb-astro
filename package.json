{
  "name": "plastikaweb-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test:eslint-rules": "node --test eslint-rules/*.test.js",
    "css:check": "node scripts/check-css-tokens.js",
    "lint:css": "stylelint \"src/**/*.{css,astro}\" --max-warnings 0",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "lint:spell": "cspell lint --no-progress",
    "check": "astro check",
    "prepare": "husky",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "version:check": "node scripts/version-badge.js",
    "version": "node scripts/version-badge.js --write && git add README.md",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "links:check": "linkinator \"**/*.{html,css}\" --config linkinator.config.json",
    "lighthouse": "node scripts/lighthouse.js"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@cspell/dict-ca": "3.1.3",
    "@cspell/dict-es-es": "3.0.9",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "5.0.5",
    "chrome-launcher": "1.2.2",
    "cspell": "10.4.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "html-validate": "11.17.0",
    "husky": "9.1.7",
    "lighthouse": "13.6.0",
    "linkinator": "8.1.0",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.24.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "puppeteer-core": "25.16.0",
    "stylelint": "17.16.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-use-logical": "2.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "eslint --fix --max-warnings 0",
      "prettier --write",
      "cspell lint --no-progress --no-summary --no-must-find-files"
    ],
    "*.astro": [
      "eslint --fix --max-warnings 0",
      "stylelint --fix --max-warnings 0",
      "prettier --write",
      "cspell lint --no-progress --no-summary --no-must-find-files"
    ],
    "*.css": [
      "stylelint --fix --max-warnings 0",
      "prettier --write",
      "cspell lint --no-progress --no-summary --no-must-find-files"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write",
      "cspell lint --no-progress --no-summary --no-must-find-files"
    ],
    "*.{json,jsonc}": [
      "prettier --write"
    ],
    "*.{yml,yaml}": [
      "prettier --write",
      "cspell lint --no-progress --no-summary --no-must-find-files"
    ]
  }
}
